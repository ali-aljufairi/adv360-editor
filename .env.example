# Unset uses process-local memory. Local compose only; never use this password in production.
# CACHE_URL=valkey://:local-development-only@127.0.0.1:6379
# Production: valkeys://:PASSWORD@HOST:6379 (TLS and authentication required).

# GitHub App OAuth credentials.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Base64-encoded random secret of at least 32 bytes.
# SESSION_SECRET=
# Comma-separated allowed GitHub logins (default: ali-aljufairi).
# ALLOWED_GITHUB_LOGINS=
# Optional public application origin; defaults to the request origin.
# APP_URL=
