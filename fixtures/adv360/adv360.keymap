#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO





        #endif

        tpf: tpf {
            compatible = "zmk,behavior-hold-tap";
            label = "TPF";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <1 2 3 4 5 8 9 10 11 12 13 27>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        mail: mail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp M &kp E &kp AT &kp A &kp L &kp J &kp U &kp F &kp A &kp I &kp R &kp I &kp DOT &kp O &kp R &kp G>;
            label = "MAIL";
        };

        name: name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(A) &kp L &kp I &kp SPACE &kp LS(R) &kp E &kp D &kp H &kp A &kp SPACE &kp LS(A) &kp L &kp I &kp SPACE &kp LS(A) &kp B &kp D &kp U &kp L &kp L &kp A &kp SPACE &kp LS(A) &kp L &kp J &kp U &kp F &kp A &kp I &kp R &kp I>;
            label = "NAME";
        };
    };

    combos {
        compatible = "zmk,combos";

#if defined(CONFIG_ZMK_STUDIO)
        // Unlock Studio without replacing any existing key assignments.
        combo_studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <46 59>;
            timeout-ms = <50>;
            layers = <0>;
        };
#endif

        combo {
            bindings = <&kp K_SCREENSAVER>;
            key-positions = <61>;
            layers = <0>;
        };

        Dfffsdfa {
            bindings = <&kp D>;
            key-positions = <35 37>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &tpf F1 NUMBER_1  &tpf F2 NUMBER_2  &tpf F3 NUMBER_3      &tpf F4 NUMBER_4  &tpf F5 N5  &kp LG(LC(NUMBER_4))                                                                                          &tog 1                &tpf F6 NUMBER_6  &tpf F7 N7  &tpf F8 NUMBER_8  &tpf F9 N9  &tpf F10 NUMBER_0  &tpf F11 MINUS
&kp TAB    &kp Q             &tpf LG(LS(W)) W  &kp E                 &kp R             &kp T       &tpf F12 C_MENU                                                                                               &kp C_PLAY_PAUSE      &kp Y             &kp U       &kp I             &kp O       &kp P              &tpf F12 BACKSLASH
&kp ESC    &kp A             &kp S             &kp D                 &kp F             &kp G       &kp RC(SPACE)         &kp LEFT_ALT  &kp LC(E)             &kp RIGHT_CONTROL  &tpf INT_KATAKANAHIRAGANA COLON  &tpf LC(GRAVE) GRAVE  &kp H             &kp J       &kp K             &kp L       &kp SEMI           &kp SQT
&kp LSHFT  &kp Z             &kp X             &tpf LS(LG(LA(C))) C  &kp V             &kp B                                           &kp LEFT_CONTROL      &kp RIGHT_ALT                                                             &kp N             &kp M       &kp COMMA         &kp DOT     &kp FSLH           &kp RSHFT
&mo 1      &kp K_MENU        &kp DELETE        &kp LEFT              &kp RIGHT                     &kp SPACE             &kp CAPSLOCK  &kp LGUI              &kp LGUI           &kp ENTER                        &kp BACKSPACE                           &kp UP      &kp DOWN          &kp LBKT    &kp RBKT           &mo 3
            >;
        };

        keypad {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                       &tog 0     &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                        &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp BACKSPACE  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                            &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 0      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp BACKSPACE  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 0
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &kp Z         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &macro_ver    &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        macro {
            bindings = <
&trans  &trans      &trans  &trans      &trans  &trans      &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_PREV  &trans  &kp C_NEXT  &trans  &bl BL_OFF  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mail       &name   &trans      &trans  &trans      &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans  &trans      &trans  &trans                      &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans  &trans      &trans              &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
